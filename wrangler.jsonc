{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "essef-store-v5",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-02",
  "assets": { "not_found_handling": "single-page-application" },
  "kv_namespaces": [
    { "binding": "ESSEF_KV", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }
  ]
}
